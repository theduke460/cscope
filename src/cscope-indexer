#! /bin/sh
###############################################################################
#
# File:         gscope-indexer
# Description:  Script to index files for gscope and cscope
#
#               When invoked as 'gscope-indexer' (default), indexes text
#               and markup file types suitable for use with gscope.
#
#               When invoked as 'cscope-indexer' (via symlink), indexes
#               C/C++ source file types suitable for use with cscope,
#               preserving classic cscope-indexer behavior.
#
#               Default indexed extensions by mode:
#
#                 gscope-indexer: md txt cap wiki rst adoc html xml
#                                 json yaml yml sh pl py rb lua go
#
#                 cscope-indexer: c h l y cc hh cpp hpp cxx
#
#               In either mode, extensions can be overridden with -e.
#               Exclusions: .git, .svn, CVS, RCS directories always skipped.
#
# Usage:
#
#     gscope-indexer [ -v ] [ -r ] [ -l ]
#                    [ -f database_file ]
#                    [ -i list_file ]
#                    [ -e "ext1 ext2 ..." ]
#                    [ directory ]
#
#     cscope-indexer [ same options ]
#
# Options:
#
#     -e "ext1 ext2 ..."
#          Space-separated list of file extensions to index (without dots).
#          Overrides the default extension list for the current mode.
#          Example: -e "md txt cap"
#
#     -f database_file
#          Specifies the database file (default: cscope.out).
#
#     -i list_file
#          Specifies the file list output file (default: cscope.files).
#
#     -l
#          List only -- suppress database generation, just build the
#          file list.
#
#     -r
#          Recurse into subdirectories.
#          Without this option, only the current directory is searched.
#
#     -v
#          Verbose -- print progress messages.
#
###############################################################################
set -e

PATH="/usr/local/bin:/sbin:/usr/sbin:/bin:/usr/bin:$PATH"
export PATH

# Detect invocation mode via argv[0] basename
MYNAME=$(basename "$0")

# Set default extensions based on invocation mode
if [ "$MYNAME" = "cscope-indexer" ]; then
    MODE="cscope"
    EXTENSIONS="c h l y cc hh cpp hpp cxx"
else
    MODE="gscope"
    EXTENSIONS="md txt cap wiki rst adoc html xml json yaml yml sh pl py rb lua go"
fi

# Defaults
LIST_ONLY=
DIR='.'
LIST_FILE='cscope.files'
DATABASE_FILE='cscope.out'
RECURSE=
VERBOSE=

export DIR RECURSE

# Parse arguments
while [ -n "$1" ]
do
    case "$1" in
    -e)
        if [ "X$2" = "X" ]
        then
            echo "$0: No extensions specified after -e" >&2
            exit 1
        fi
        EXTENSIONS="$2"
        shift
        ;;
    -f)
        if [ "X$2" = "X" ]
        then
            echo "$0: No database file specified after -f" >&2
            exit 1
        fi
        DATABASE_FILE="$2"
        shift
        ;;
    -i)
        if [ "X$2" = "X" ]
        then
            echo "$0: No list file specified after -i" >&2
            exit 1
        fi
        LIST_FILE="$2"
        shift
        ;;
    -l)
        LIST_ONLY=1
        ;;
    -r)
        RECURSE=1
        ;;
    -v)
        VERBOSE=1
        ;;
    -*)
        echo "$0: Unknown option: $1" >&2
        exit 1
        ;;
    *)
        DIR="$1"
        ;;
    esac
    shift
done

# Build the egrep pattern from the extension list
EXT_PATTERN=""
for ext in $EXTENSIONS
do
    ext=$(echo "$ext" | sed 's/^\.//')   # strip leading dot if present
    if [ "X$EXT_PATTERN" = "X" ]
    then
        EXT_PATTERN="$ext"
    else
        EXT_PATTERN="$EXT_PATTERN|$ext"
    fi
done
EXT_PATTERN="\\.($EXT_PATTERN)\$"

if [ "X$VERBOSE" != "X" ]
then
    echo "$MYNAME: mode: $MODE"
    echo "$MYNAME: indexing extensions: $EXTENSIONS"
    echo "$MYNAME: pattern: $EXT_PATTERN"
    echo "$MYNAME: creating file list ..."
fi

cd $DIR

(
    if [ "X$RECURSE" = "X" ]
    then
        for f in *
        do
            echo "$DIR/$f"
        done
    else
        find $DIR \( -type f -o -type l \) \
            ! -path '*/.git/*'   \
            ! -path '*/CVS/*'    \
            ! -path '*/RCS/*'    \
            ! -path '*/.svn/*'
    fi
) | \
    egrep -i "$EXT_PATTERN" | \
    sort | \
    sed -e '/[ \t]/s/^.*$/\"&\"/' > $LIST_FILE

# Report how many files were found
FILECOUNT=$(wc -l < $LIST_FILE | tr -d ' ')
if [ "X$VERBOSE" != "X" ]
then
    echo "$MYNAME: $FILECOUNT file(s) found."
    echo "$MYNAME: creating file list ... done"
fi

if [ "$FILECOUNT" -eq 0 ]
then
    echo "$0: Warning: no matching files found. Check directory and extensions." >&2
    exit 1
fi

if [ "X$LIST_ONLY" != "X" ]
then
    exit 0
fi

if [ "X$VERBOSE" != "X" ]
then
    echo "$MYNAME: building database ..."
fi

cscope -b -i $LIST_FILE -f $DATABASE_FILE

if [ "X$VERBOSE" != "X" ]
then
    echo "$MYNAME: building database ... done"
    echo "$MYNAME: database written to $DATABASE_FILE"
fi

exit 0
